{
  "name": "@neumie/pi-footer",
  "version": "0.4.1",
  "description": "A compact two-row session footer for Pi.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neumie/pi-footer.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "footer"
  ],
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "test": "node --experimental-transform-types --test test/*.test.ts",
    "check": "npm run typecheck && npm run typecheck:test && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/footer.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.82.1 <0.84.0",
    "@earendil-works/pi-tui": ">=0.82.1 <0.84.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
